# Large binary files
*.node filter=lfs diff=lfs merge=lfs -text

# Large webpack and compiled files
**/next/dist/compiled/** filter=lfs diff=lfs merge=lfs -text

# Large dependency binaries
**/node_modules/**/*.so filter=lfs diff=lfs merge=lfs -text
**/node_modules/**/*.dll filter=lfs diff=lfs merge=lfs -text
**/node_modules/**/*.dylib filter=lfs diff=lfs merge=lfs -text

# Large media and archive files
*.zip filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text